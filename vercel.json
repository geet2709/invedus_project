{
    "version": 3,
    "builds": [
      {
        "src": "fend/package.json",
        "use": "@vercel/static-build"
      },
      {
        "src": "api/server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/api/server.js"
      },
      {
        "src": "/(.*)",
        "dest": "/fend/build/$1"
      }
    ]
  }
  